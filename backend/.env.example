# =============================================
# Backend Environment Variables
# =============================================
# Copy this file to .env and fill in the values

# ==================
# Database (SQLite)
# ==================
# Local dev:
DATABASE_URL="file:./database.sqlite"
# Railway/Render (persistent volume):
# DATABASE_URL="file:/data/database.sqlite"

# ==================
# JWT Secret
# ==================
# !! เปลี่ยนให้เป็น random string ที่ยาวและซับซ้อนก่อน deploy !!
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION"

# ==================
# Server
# ==================
PORT=3001
NODE_ENV=development

# ==================
# URLs (สำหรับ production)
# ==================
# URL ของ backend เอง (ใช้สร้าง video URL)
# BACKEND_URL=https://elearning-backend.onrender.com

# URL ของ frontend (ใช้ตั้ง CORS whitelist)
# FRONTEND_URL=https://your-frontend.vercel.app

# ==================
# File Storage
# ==================
# Local: ไม่ต้องตั้ง — จะใช้ ./uploads อัตโนมัติ
# Railway/Render (persistent volume):
# UPLOAD_DIR=/data/uploads
