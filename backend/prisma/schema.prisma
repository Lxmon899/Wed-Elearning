generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("student")
  createdAt DateTime @default(now()) @map("created_at")

  enrollments   Enrollment[]
  progresses    Progress[]
  quizAttempts  QuizAttempt[]
  notifications Notification[]
  
  @@map("users")
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  instructor  String
  thumbnail   String?
  price       Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  enrollments  Enrollment[]
  lessons      Lesson[]
  questions    Question[]
  quizAttempts QuizAttempt[]
  
  @@map("courses")
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  videoUrl  String   @map("video_url")
  duration  Int?     // ความยาววิดีโอ (วินาที)
  order     Int      @default(0) // ลำดับบทเรียน
  courseId  Int      @map("course_id")

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses Progress[]
  questions  Question[]
  
  @@map("lessons")
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  courseId  Int      @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Progress {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  lessonId       Int      @map("lesson_id")
  completed      Boolean  @default(false)
  watchedSeconds Int      @default(0) @map("watched_seconds")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("progresses")
}

model Question {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  lessonId    Int?     @map("lesson_id")
  text        String   // คำถาม
  explanation String?  // คำอธิบายเฉลย
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  choices Choice[]

  @@map("questions")
}

model Choice {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  text       String  // ตัวเลือกคำตอบ
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("choices")
}

model QuizAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  courseId       Int      @map("course_id")
  score          Int      // คะแนนที่ได้
  totalQuestions Int      @map("total_questions")
  passed         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  type      String   @default("info") // info, course, certificate, quiz, success
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}